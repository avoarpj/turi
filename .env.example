# Os caminhos padrão pertencem à raiz do Turi; nenhum SDS HTTP é necessário.
TURI_BASE_DIR_EXTENSION=
# DUMPS_OUTPUT_DIR=/caminho/absoluto/parquet_dumps
VENATO_DATA_DIR=venato_data

# Pool do operador, não um limite global de RSS. Usar disco, não tmpfs.
TURI_UNIQUE_TEMP_DIRECTORY=.turi_unique_tmp
TURI_UNIQUE_MEMORY_LIMIT=256MiB
TURI_SORT_MEMORY_LIMIT=256MiB
TURI_SORT_MAX_TEMP_DIRECTORY_SIZE=24G

SNOWFLAKE_INSTANCE_ID=0
SNOWFLAKE_EPOCH=1741477800000

# Header Cookie completo para o catálogo CKAN do TSE; vazio omite o header.
TSE_CKAN_COOKIE=
