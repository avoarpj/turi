{
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "file:/**/*.parquet": "jupyter-data-wrangler",
        "*.parquet": "duckdb.dataFileViewer",
        "*.csv": "duckdb.dataFileViewer",
        "*.tsv": "duckdb.dataFileViewer",
        "*.xlsx": "duckdb.dataFileViewer"
    },
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
        "**/assets/brazilgeo": false,
        "**/assets/candidatures": false,
        "**/assets/localidades": false
    },
    "files.watcherExclude": {
        "**/assets/brazilgeo/**": true,
        "**/assets/candidatures/**": true,
        "**/assets/localidades/**": true
    },
    "search.exclude": {
        "**/assets/brazilgeo": true,
        "**/assets/candidatures": true,
        "**/assets/localidades": true
    },
    "python.analysis.exclude": [
        "**/assets/localidades"
    ]
}
